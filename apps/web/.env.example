# Frontend environment variables (Vite — must be prefixed with VITE_ to be exposed).
# The dev server proxies /api to the backend; see vite.config.ts.

# Base URL of the deployed API (used in production builds).
VITE_API_BASE_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/api

# Logto (self-hosted, see logto-flyio) — the "quizaroni" SPA application and
# "Quizaroni API" resource under the Quizaroni org in the Logto console.
VITE_LOGTO_ENDPOINT=https://logto-af.fly.dev
VITE_LOGTO_APP_ID=o22m3fhlrt4jaa32f82ah
VITE_LOGTO_API_RESOURCE=https://api.quizaroni.yusufaf.dev

# Shows the Publish to Explore entry point. Keep off in production until Report ships.
# VITE_FEATURE_PUBLISH=false
